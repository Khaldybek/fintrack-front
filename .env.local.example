# Скопируйте в .env.local для разработки. На сервере задайте те же переменные в окружении перед `npm run build`.

# Базовый URL API (без /v1). После сборки менять только через новый build.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Продакшен (fintrack.kaz-ai.com + API на поддомене) ---
# Страница фронта по HTTPS не может вызывать API по HTTP (Mixed Content).
# Укажите API только с https:// и убедитесь, что на API включён TLS (nginx + Let's Encrypt).
# NEXT_PUBLIC_API_URL=https://admin-fintrack.kaz-ai.com

# OAuth: финальный редирект бэка на фронт должен вести на /auth/callback (см. документацию бэка).

# --- CORS и refresh-cookie (настраивается на бэкенде, не во фронте) ---
# Если фронт и API на разных поддоменах (fintrack.* и admin-fintrack.*), запросы к API — cross-site.
# Refresh cookie должна отдаваться с атрибутами: Secure; SameSite=None; при необходимости Domain=.kaz-ai.com
# CORS: Allow-Origin = точный origin фронта (https://fintrack.kaz-ai.com), не "*"; Allow-Credentials: true
